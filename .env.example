# One connection string, any supported database.
# Postgres:  postgres://user:pass@host:5432/dbname
# MySQL:     mysql://user:pass@host:3306/dbname
# SQLite:    sqlite:///absolute/path/to/file.db
DATABASE_URL=sqlite:///absolute/path/to/file.db

# Optional: force the database kind if it can't be inferred from DATABASE_URL.
# One of: postgres, mysql, sqlite
# DB_TYPE=sqlite

# Optional tuning (all have sane defaults):
# DEFAULT_ROW_LIMIT=200
# MAX_ROW_LIMIT=1000
# QUERY_TIMEOUT_MS=5000
# SCHEMA_CACHE_TTL_MS=300000

# Optional: serve over HTTP instead of stdio, so many MCP sessions can share
# one process/connection pool. See README "Running at scale" for when to use
# this. Leave unset for the default single-agent stdio mode.
# MCP_TRANSPORT=http
# MCP_HTTP_ADDR=:8080
# MCP_HTTP_AUTH_TOKEN=a-long-random-secret

# Optional: schema business-context search (teach_schema_context /
# search_schema_context tools). Off by default, since it needs a local
# Ollama server running with an embedding model pulled
# (`ollama pull bge-m3`). Set SCHEMA_CONTEXT_ENABLED=true to register the
# two tools; everything below it has sane defaults if left unset.
# SCHEMA_CONTEXT_ENABLED=true
# EMBEDDING_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# EMBEDDING_MODEL=bge-m3          # lighter multilingual alternative: paraphrase-multilingual

# VECTOR_STORE_KIND=memory        # only kind for now; in-memory + JSON file
# VECTOR_STORE_PATH=schema_context.json
