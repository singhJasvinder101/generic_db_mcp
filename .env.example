# One connection string, any supported database.
# Postgres:  postgres://user:pass@host:5432/dbname
# MySQL:     mysql://user:pass@host:3306/dbname
# SQLite:    sqlite:///absolute/path/to/file.db
DATABASE_URL=sqlite:///absolute/path/to/file.db

# Optional: force the database kind if it can't be inferred from DATABASE_URL.
# One of: postgres, mysql, sqlite
# DB_TYPE=sqlite

# Optional tuning (all have sane defaults):
# DEFAULT_ROW_LIMIT=200
# MAX_ROW_LIMIT=1000
# QUERY_TIMEOUT_MS=5000
# SCHEMA_CACHE_TTL_MS=300000
