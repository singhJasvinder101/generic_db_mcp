# Gemini API key: https://ai.google.dev/gemini-api/docs/api-key
GEMINI_API_KEY=your-gemini-api-key

# Optional: override the model (defaults to gemini-2.5-flash).
# GEMINI_MODEL=gemini-2.5-flash

# Optional: path to the generic-db-mcp binary and its working directory
# (the directory that holds the root .env with DATABASE_URL). Defaults
# assume you're running this sample from ./sample against the project root.
# MCP_SERVER_PATH=../bin/generic-db-mcp
# MCP_SERVER_DIR=..
